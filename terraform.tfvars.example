# Copy to terraform.tfvars and fill in.
alert_email = "you@example.com"

# Test setup you will delete afterwards: false lets `terraform destroy` remove everything (database included).
protect_data = true

# Optional
# vpc_cidr          = "10.40.0.0/16"
# use_spot          = true            # extra customer/partner copies on Fargate Spot (~70% cheaper)
# services = {                        # cpu 256 = 0.25 vCPU, 512 = 0.5 vCPU; memory in MB; min/max copies
#   customer = { cpu = 256, memory = 512, min = 1, max = 4 }
#   partner  = { cpu = 256, memory = 512, min = 1, max = 3 }
#   admin    = { cpu = 256, memory = 512, min = 1, max = 1 }
# }
# db_instance_class           = "db.t4g.micro"
# db_multi_az                 = false   # true = standby database in a second zone (2x database cost)
# db_read_replica             = true    # false saves about $18/month; reads then use the main database
# monthly_budget_usd          = 100     # e-mail when the bill is forecast to pass this
# admin_allowed_ips           = ["203.0.113.10"]
# create_github_oidc_provider = false   # if the account already has GitHub's identity provider
